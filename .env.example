APP_NAME=Production Process Sales & Action Management System
ENVIRONMENT=development
SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=720
SESSION_IDLE_TIMEOUT_MINUTES=60
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
# Keep false while Oracle is running on HTTP. Set true only after HTTPS is confirmed working.
REQUIRE_HTTPS=false
# Set true only when the app is behind a trusted reverse proxy that supplies X-Forwarded-* headers.
TRUST_PROXY_HEADERS=false

# Fresh installations receive a generated database password from configure_env.
# Existing installations are preserved; use rotate_database_password_* to replace a legacy pms password safely.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://pms:CHANGE_THIS_TO_A_RANDOM_DATABASE_PASSWORD@db:5432/pms
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# Host bindings: DB/backend stay local to the server; frontend can be reached from the LAN/Internet.
DB_BIND=127.0.0.1
BACKEND_BIND=127.0.0.1
FRONTEND_BIND=0.0.0.0
FRONTEND_PORT=5173

# Independent AFMS MQTT broker. Keep this hostname separate from the website URL.
MQTT_DOMAIN=machineshop.duckdns.org
MQTT_BIND=127.0.0.1
MQTT_PORT=8883
# Generated automatically for a fresh .env by configure_env.py / configure_env.ps1. Do not rotate on an initialized broker.
MQTT_DYNSEC_PASSWORD=
# Generated automatically for a fresh .env; provision_mqtt.sh creates this client with the dynsec-admin role.
MQTT_ENABLED=false
MQTT_HOST=mqtt
MQTT_INTERNAL_PORT=1883
MQTT_CONTROL_USERNAME=prw-afms-control
MQTT_CONTROL_PASSWORD=
# Generated automatically for a fresh .env; provision_mqtt.sh creates this least-privilege client.
MQTT_BACKEND_USERNAME=prw-afms-backend
MQTT_BACKEND_PASSWORD=
MQTT_TIMEOUT_SECONDS=8

IMPORT_MAX_MB=32
ATTACHMENT_MAX_MB=25
OFFICE_MAX_UNCOMPRESSED_MB=128
ATTACHMENT_ALLOWED_EXTENSIONS=.pdf,.png,.jpg,.jpeg,.webp,.xlsx,.xlsm,.docx,.pptx,.txt,.csv
BACKUP_MAX_AGE_HOURS=48
RESTORE_VERIFY_MAX_AGE_DAYS=30

ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!
ADMIN_FULL_NAME=System Administrator
PLANT_NAME=Main Plant
UPLOAD_DIR=/app/uploads

ATTACHMENTS_DIR=/app/attachments
BACKUP_DIR=/app/backups

# Absolute public URL used in printed gauge QR labels (no trailing slash)
PUBLIC_APP_URL=https://your-production-review-domain
